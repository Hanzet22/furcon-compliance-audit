{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hanzet22.github.io/furcon-compliance-audit/schemas/translation.schema.json",
  "title": "translation",
  "description": "Translation provenance linked to original evidence.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "translation_id": {
      "$ref": "#/$defs/id"
    },
    "evidence_id": {
      "$ref": "#/$defs/id"
    },
    "source_language": {
      "type": "string"
    },
    "target_language": {
      "type": "string"
    },
    "method": {
      "enum": [
        "human",
        "machine",
        "official",
        "other"
      ]
    },
    "provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "translated_text": {
      "type": "string"
    },
    "created_at": {
      "$ref": "#/$defs/ts"
    },
    "verification_status": {
      "enum": [
        "unreviewed",
        "verified",
        "rejected"
      ]
    },
    "reviewer_role": {
      "type": [
        "string",
        "null"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "translation_id",
    "evidence_id",
    "source_language",
    "target_language",
    "method",
    "translated_text",
    "created_at",
    "verification_status"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,63}$"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "workflow": {
      "enum": [
        "not_started",
        "in_progress",
        "completed",
        "partial",
        "blocked",
        "not_applicable"
      ]
    },
    "assessment": {
      "enum": [
        "supported_concern",
        "no_issue_observed",
        "needs_clarification",
        "not_assessed",
        "not_applicable"
      ]
    },
    "applicability": {
      "enum": [
        "applicable_supported",
        "potentially_applicable",
        "not_established",
        "not_applicable_supported",
        "not_assessed"
      ]
    },
    "review": {
      "enum": [
        "not_required",
        "pending",
        "in_review",
        "changes_requested",
        "accepted",
        "rejected",
        "stale"
      ]
    },
    "task": {
      "enum": [
        "queued",
        "running",
        "completed",
        "partial",
        "blocked",
        "failed",
        "cancelled"
      ]
    },
    "attempt": {
      "enum": [
        "succeeded",
        "no_results",
        "failed",
        "rate_limited",
        "blocked",
        "skipped"
      ]
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "moderate",
        "low",
        "informational"
      ]
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    }
  }
}
