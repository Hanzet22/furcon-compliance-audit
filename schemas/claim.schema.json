{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hanzet22.github.io/furcon-compliance-audit/schemas/claim.schema.json",
  "title": "claim",
  "description": "Factual proposition.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "claim_id": {
      "$ref": "#/$defs/id"
    },
    "statement": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "activity": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "claim_type": {
      "enum": [
        "organizer_statement",
        "observed_practice",
        "event_fact",
        "user_supplied_fact",
        "other"
      ]
    },
    "evidence_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evidence_id": {
            "$ref": "#/$defs/id"
          },
          "relationship": {
            "enum": [
              "supports",
              "contradicts",
              "qualifies",
              "context"
            ]
          }
        },
        "required": [
          "evidence_id",
          "relationship"
        ]
      },
      "uniqueItems": true
    },
    "verification_status": {
      "enum": [
        "unverified",
        "partially_supported",
        "supported",
        "contradicted",
        "mixed"
      ]
    }
  },
  "required": [
    "schema_version",
    "claim_id",
    "statement",
    "actor",
    "evidence_ids"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,63}$"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "workflow": {
      "enum": [
        "not_started",
        "in_progress",
        "completed",
        "partial",
        "blocked",
        "not_applicable"
      ]
    },
    "assessment": {
      "enum": [
        "supported_concern",
        "no_issue_observed",
        "needs_clarification",
        "not_assessed",
        "not_applicable"
      ]
    },
    "applicability": {
      "enum": [
        "applicable_supported",
        "potentially_applicable",
        "not_established",
        "not_applicable_supported",
        "not_assessed"
      ]
    },
    "review": {
      "enum": [
        "not_required",
        "pending",
        "in_review",
        "changes_requested",
        "accepted",
        "rejected",
        "stale"
      ]
    },
    "task": {
      "enum": [
        "queued",
        "running",
        "completed",
        "partial",
        "blocked",
        "failed",
        "cancelled"
      ]
    },
    "attempt": {
      "enum": [
        "succeeded",
        "no_results",
        "failed",
        "rate_limited",
        "blocked",
        "skipped"
      ]
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "moderate",
        "low",
        "informational"
      ]
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    }
  }
}\n