{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hanzet22.github.io/furcon-compliance-audit/schemas/source.schema.json",
  "title": "source",
  "description": "Normalized source identity.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "source_id": {
      "$ref": "#/$defs/id"
    },
    "canonical_url": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_type": {
      "enum": [
        "official_event",
        "organizer_controlled",
        "legal_authority",
        "regulator_guidance",
        "third_party",
        "unverified"
      ]
    },
    "verification_status": {
      "enum": [
        "verified",
        "partially_verified",
        "unverified",
        "excluded"
      ]
    },
    "verification_rationale": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "source_id",
    "canonical_url",
    "source_type",
    "verification_status"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,63}$"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "workflow": {
      "enum": [
        "not_started",
        "in_progress",
        "completed",
        "partial",
        "blocked",
        "not_applicable"
      ]
    },
    "assessment": {
      "enum": [
        "supported_concern",
        "no_issue_observed",
        "needs_clarification",
        "not_assessed",
        "not_applicable"
      ]
    },
    "applicability": {
      "enum": [
        "applicable_supported",
        "potentially_applicable",
        "not_established",
        "not_applicable_supported",
        "not_assessed"
      ]
    },
    "review": {
      "enum": [
        "not_required",
        "pending",
        "in_review",
        "changes_requested",
        "accepted",
        "rejected",
        "stale"
      ]
    },
    "task": {
      "enum": [
        "queued",
        "running",
        "completed",
        "partial",
        "blocked",
        "failed",
        "cancelled"
      ]
    },
    "attempt": {
      "enum": [
        "succeeded",
        "no_results",
        "failed",
        "rate_limited",
        "blocked",
        "skipped"
      ]
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "moderate",
        "low",
        "informational"
      ]
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    }
  }
}
