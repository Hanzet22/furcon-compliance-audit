{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hanzet22.github.io/furcon-compliance-audit/schemas/evidence.schema.json",
  "title": "evidence",
  "description": "Preserved evidence from retrieval.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "evidence_id": {
      "$ref": "#/$defs/id"
    },
    "retrieval_id": {
      "$ref": "#/$defs/id"
    },
    "kind": {
      "enum": [
        "quotation",
        "observation",
        "document_artifact",
        "metadata"
      ]
    },
    "excerpt": {
      "type": "string"
    },
    "locator": {
      "type": [
        "string",
        "null"
      ]
    },
    "original_language": {
      "type": [
        "string",
        "null"
      ]
    },
    "captured_at": {
      "$ref": "#/$defs/ts"
    }
  },
  "required": [
    "schema_version",
    "evidence_id",
    "retrieval_id",
    "kind",
    "excerpt",
    "captured_at"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,63}$"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "workflow": {
      "enum": [
        "not_started",
        "in_progress",
        "completed",
        "partial",
        "blocked",
        "not_applicable"
      ]
    },
    "assessment": {
      "enum": [
        "supported_concern",
        "no_issue_observed",
        "needs_clarification",
        "not_assessed",
        "not_applicable"
      ]
    },
    "applicability": {
      "enum": [
        "applicable_supported",
        "potentially_applicable",
        "not_established",
        "not_applicable_supported",
        "not_assessed"
      ]
    },
    "review": {
      "enum": [
        "not_required",
        "pending",
        "in_review",
        "changes_requested",
        "accepted",
        "rejected",
        "stale"
      ]
    },
    "task": {
      "enum": [
        "queued",
        "running",
        "completed",
        "partial",
        "blocked",
        "failed",
        "cancelled"
      ]
    },
    "attempt": {
      "enum": [
        "succeeded",
        "no_results",
        "failed",
        "rate_limited",
        "blocked",
        "skipped"
      ]
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "moderate",
        "low",
        "informational"
      ]
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    }
  }
}
