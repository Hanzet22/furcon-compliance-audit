{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hanzet22.github.io/furcon-compliance-audit/schemas/evidence.schema.json",
  "title": "evidence",
  "description": "Explicitly selected evidence excerpt or observation linked to a successful retrieval.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "evidence_id": {
      "$ref": "#/$defs/id"
    },
    "retrieval_id": {
      "$ref": "#/$defs/id"
    },
    "kind": {
      "enum": [
        "quotation",
        "observation",
        "document_artifact",
        "metadata"
      ]
    },
    "excerpt": {
      "type": "string",
      "minLength": 1
    },
    "locator": {
      "type": [
        "string",
        "null"
      ]
    },
    "original_language": {
      "type": [
        "string",
        "null"
      ]
    },
    "captured_at": {
      "$ref": "#/$defs/ts"
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "content_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "evidence_id",
    "retrieval_id",
    "kind",
    "excerpt",
    "captured_at",
    "source_url"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,63}$"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    }
  }
}
