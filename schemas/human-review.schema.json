{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hanzet22.github.io/furcon-compliance-audit/schemas/human-review.schema.json",
  "title": "human-review",
  "description": "Human review record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "review_id": {
      "$ref": "#/$defs/id"
    },
    "target_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "reviewer_role": {
      "type": "string"
    },
    "review_status": {
      "$ref": "#/$defs/review"
    },
    "decision": {
      "enum": [
        "approve",
        "request_changes",
        "reject",
        "defer",
        "not_required"
      ]
    },
    "reviewed_at": {
      "$ref": "#/$defs/ts"
    },
    "revision": {
      "type": "string"
    },
    "rationale": {
      "type": [
        "string",
        "null"
      ]
    },
    "stale_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "review_id",
    "target_ids",
    "reviewer_role",
    "review_status",
    "decision",
    "reviewed_at",
    "revision"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,63}$"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "workflow": {
      "enum": [
        "not_started",
        "in_progress",
        "completed",
        "partial",
        "blocked",
        "not_applicable"
      ]
    },
    "assessment": {
      "enum": [
        "supported_concern",
        "no_issue_observed",
        "needs_clarification",
        "not_assessed",
        "not_applicable"
      ]
    },
    "applicability": {
      "enum": [
        "applicable_supported",
        "potentially_applicable",
        "not_established",
        "not_applicable_supported",
        "not_assessed"
      ]
    },
    "review": {
      "enum": [
        "not_required",
        "pending",
        "in_review",
        "changes_requested",
        "accepted",
        "rejected",
        "stale"
      ]
    },
    "task": {
      "enum": [
        "queued",
        "running",
        "completed",
        "partial",
        "blocked",
        "failed",
        "cancelled"
      ]
    },
    "attempt": {
      "enum": [
        "succeeded",
        "no_results",
        "failed",
        "rate_limited",
        "blocked",
        "skipped"
      ]
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "moderate",
        "low",
        "informational"
      ]
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    }
  }
}
